{
  "name": "easyworship-app",
  "version": "2.0.7",
  "description": "Presentation For Church - Worship Presentation App",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "npm run build:all",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:all": "electron-builder --win --mac"
  },
  "build": {
    "appId": "com.church.presentation",
    "productName": "Presentation For Church",
    "artifactName": "Presentation.For.Church.Setup.${version}.${ext}",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "live.html",
      "edit-song.html",
      "src/**/*",
      "data/**/*",
      "fonts/**/*",
      "media/**/*",
      "icon.png",
      "icon.ico",
      "icon.icns",
      "package.json"
    ],
    "asarUnpack": [
      "media/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ],
      "icon": "build/icon.ico"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": ["arm64", "x64"]
        }
      ],
      "icon": "build/icon.icns",
      "category": "public.app-category.utilities",
      "identity": null
    },
    "dmg": {
      "artifactName": "Presentation.For.Church.macOS.${arch}.${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Presentation For Church",
      "deleteAppDataOnUninstall": false,
      "include": "build/installer.nsh",
      "artifactName": "Presentation.For.Church.Setup.${version}.${ext}"
    },
    "portable": {
      "artifactName": "Presentation.For.Church.Portable.${version}.${ext}"
    }
  },
  "devDependencies": {
    "electron": "^41.0.2",
    "electron-builder": "^26.8.1"
  },
  "dependencies": {
    "mammoth": "^1.12.0"
  }
}
